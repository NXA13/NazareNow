[Unit]
# The read-only API, bound to localhost only.
#
# Nothing reaches this directly. nginx terminates TLS, checks the password and proxies to
# it — ADR 0007 puts the API behind the same wall as the page, on the same origin, because
# a private page in front of a public /api/conditions/forecast is not private: that
# endpoint *is* the store.
#
# Ordered after the scheduler deliberately. `api.py`'s store is opened with `create=False`,
# so on a host where nothing has ingested yet there is no database to open and this exits.
# That is the correct behaviour — creating one here would turn a misconfigured path into an
# empty database and answer "no conditions yet", a config fault wearing the costume of a
# data gap — but it means the first start after a rebuild has to wait for the scheduler's
# first run. Restart= below is what makes that self-healing rather than a manual step.
Description=NazareNow read-only API
Documentation=https://github.com/NXA13/NazareNow/blob/main/deploy/README.md
After=network-online.target nazarenow-scheduler.service
Wants=network-online.target

[Service]
Type=simple
User=nazarenow
Group=nazarenow
EnvironmentFile=/etc/nazarenow/nazarenow.env
WorkingDirectory=/opt/nazarenow

# 127.0.0.1 and not 0.0.0.0. Binding publicly would put the store on the network beside
# the wall rather than behind it, reachable on the Pi's LAN address with no password at
# all. One worker: SQLite, one small host, and ADR 0005 makes every request a read of
# precomputed results.
ExecStart=/opt/nazarenow/venv/bin/uvicorn nazarenow.api:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

# Covers both the ordinary crash and the first boot after a rebuild, when the store does
# not exist yet and this exits on purpose until the scheduler has made one.
Restart=always
RestartSec=15

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Read-only here: ADR 0005 says the API is strictly a reader, and SQLite enforces it
# already. This makes the filesystem agree.
ReadOnlyPaths=/mnt/ssd/nazarenow

[Install]
WantedBy=multi-user.target
