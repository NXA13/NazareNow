# Host configuration for a NazaréNow deployment.
#
# Copy to /etc/nazarenow/nazarenow.env on the host, edit, and keep it there. It is read by
# every unit in deploy/systemd/, so the API, the scheduler and the backup timer cannot end
# up disagreeing about where the store is — which is the failure ADR 0005 warns about, and
# which presents as "no conditions have been ingested yet" beside a perfectly good database.
#
# This file is the example. The real one never enters the repository.
#   sudo install -d -m 750 -o nazarenow -g nazarenow /etc/nazarenow
#   sudo install -m 640 -o root -g nazarenow deploy/nazarenow.env.example /etc/nazarenow/nazarenow.env

# --- The store ---------------------------------------------------------------------
#
# On the SSD, never on the SD card. Two reasons: an SD card's write endurance is finite and
# a Pipeline Run writes every three hours forever, and ADR 0007 names this file as the one
# asset whose loss costs the project every accuracy claim it will ever make.
#
# `store.py` anchors its default path to the repository, which is right for a source
# checkout and wrong for an installed package — the anchor would land beside the
# virtualenv. A packaged deployment must set this explicitly.
NAZARENOW_DB=/mnt/ssd/nazarenow/nazarenow.db

# --- Backups -----------------------------------------------------------------------
#
# Where `backup-store.sh` writes its snapshots. On the SSD by default, which protects
# against corruption of the live file but NOT against losing the machine.
NAZARENOW_BACKUP_DIR=/mnt/ssd/nazarenow/backups

# How many local snapshots to keep before the oldest is deleted.
NAZARENOW_BACKUP_KEEP=30

# An rclone remote, as `remote:path`. Leave empty and backups stay on the host — which
# ADR 0007's criterion explicitly does not accept, because a snapshot on the same SSD as
# the original dies with it. Set it and every snapshot is copied off the machine.
#   rclone config            # once, interactively, to create the remote
NAZARENOW_BACKUP_REMOTE=
